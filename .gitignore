.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
android/.gradle/
android/local.properties
*.iml
.idea/
.vscode/
# Local agent/editor tooling state, same category as .idea and .vscode.
.claude/
.DS_Store
pubspec.lock
web/
ios/
linux/
macos/
windows/
android/
.metadata
deutschgarden.bundle
deutschgarden.zip

# `flutter create` scaffolds a counter-app widget test on every setup. It cannot
# compile against this project — the real widget test is test/app_smoke_test.dart
# — so it is ignored here rather than deleted by hand each time. CI removes it
# too, for the case where it is generated inside the job.
test/widget_test.dart

# Android release signing. The keystore and its passwords are the app's
# identity: anyone holding them can publish an update that Android will accept
# as genuine. They live outside the repository and are injected into CI from
# repository secrets.
key.properties
*.jks
*.keystore

# Scratch dumps produced while generating content. They are working files, not
# source, and one of them (existing.txt) reached a commit before this rule.
existing.txt
relevel_candidates.txt
batch.json

# Python content tools leave bytecode caches beside their sources. They are
# machine-local build products, never curriculum source.
__pycache__/
*.py[cod]

# Hand-built release archives, uploaded to GitHub releases rather than committed
dist/
